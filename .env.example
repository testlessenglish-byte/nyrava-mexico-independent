# ==============================================================================
# NYRAVA MÉXICO — DOCKER PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT REAL SECRET VALUES OR .env TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server / Container Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
NITRO_PRESET=node-server

# ------------------------------------------------------------------------------
# Supabase Configuration (Independently Owned Project)
# ------------------------------------------------------------------------------
# Your independent Supabase project endpoint
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable/Anon API key (used by client & public auth flows)
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Optional client-side Vite aliases (mirrors the values above)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Supabase Service Role Key (STRICTLY SERVER-SIDE ONLY — NEVER EXPOSE TO CLIENT)
# Used for backend legal pipeline workers, cron hooks, and administrative tasks
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# Transactional Email (Provider-Neutral)
# ------------------------------------------------------------------------------
# Configure ONE of the following independent providers:
# Provider 1: Resend
RESEND_API_KEY=
# Provider 2: SendGrid
SENDGRID_API_KEY=
# Provider 3: Custom Webhook
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# Email Sender Identities
EMAIL_FROM=Nyrava México <notificaciones@mexico.nyrava.com>
EMAIL_REPLY_TO=support@mexico.nyrava.com
EMAIL_DOMAIN=mexico.nyrava.com

# ------------------------------------------------------------------------------
# AI Engine Providers (Server-Side Only)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Payment Gateways (Server-Side Only)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADO_PAGO_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# Pipeline & Background Worker Configuration
# ------------------------------------------------------------------------------
PIPELINE_WORKER_MAX_PER_TICK=3
PIPELINE_MAX_CONCURRENT=2
FINDINGS_PROJECTION_ENABLED=true
